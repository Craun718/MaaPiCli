@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG REQUIRED COMPONENTS system regex)
find_dependency(OpenCV REQUIRED COMPONENTS core imgproc imgcodecs)
find_dependency(MaaFramework CONFIG REQUIRED)
if(NOT WIN32 AND NOT APPLE)
    find_dependency(OpenSSL REQUIRED COMPONENTS Crypto)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MaaPiCliTargets.cmake")

check_required_components(MaaPiCli)
