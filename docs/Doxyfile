# Doxyfile 1.10.0

DOXYFILE_ENCODING = UTF-8
PROJECT_NAME = "MaaPiCli"
PROJECT_NUMBER = $(DOC_VERSION)
PROJECT_BRIEF = "Command-line ProjectInterface client for MaaFramework"
OUTPUT_DIRECTORY = ./docs-gen
OUTPUT_LANGUAGE = English
TAB_SIZE = 4
OPTIMIZE_OUTPUT_FOR_C = NO
BUILTIN_STL_SUPPORT = YES
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
CASE_SENSE_NAMES = SYSTEM
SORT_MEMBER_DOCS = NO
GENERATE_TODOLIST = YES
GENERATE_TESTLIST = YES
GENERATE_BUGLIST = YES
GENERATE_DEPRECATEDLIST = YES
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_FORMAT = "$file:$line: $text"
INPUT = ./include
INPUT_ENCODING = UTF-8
FILE_PATTERNS = *.h
RECURSIVE = YES
EXCLUDE_SYMLINKS = NO
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = \
    "MAA_PROJECT_INTERFACE_NS=MaaPiCli::ProjectInterfaceNS" \
    "MAA_PROJECT_INTERFACE_NS_BEGIN=namespace MaaPiCli::ProjectInterfaceNS {" \
    "MAA_PROJECT_INTERFACE_NS_END=}" \
    "MEO_JSONIZATION(...)="
GENERATE_HTML = YES
HTML_OUTPUT = html
HTML_FILE_EXTENSION = .html
HTML_DYNAMIC_MENUS = YES
HTML_COPY_CLIPBOARD = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_XML = YES
XML_OUTPUT = html/xml
GENERATE_LATEX = NO
ALPHABETICAL_INDEX = NO
